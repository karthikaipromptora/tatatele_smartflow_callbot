# Copy to .env and fill in.

# ── Server ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8011

# ── Speech (Sarvam: saarika STT + bulbul TTS) ──────────────────
SARVAM_API_KEY=

# ── LLM (self-hosted, OpenAI-compatible) ───────────────────────
LOCAL_LLM_URL=http://164.52.198.104:8049/v1
LOCAL_LLM_MODEL=google/gemma-4-26B-A4B-it

# ── Database (Neon Postgres) ───────────────────────────────────
# Paste the Neon connection string as-is, e.g.
# postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=

# ── SmartFlow Click to Call Support API ────────────────────────
# Portal → API Connect → API Tokens (sent as "Authorization: Bearer <token>")
SMARTFLOW_API_TOKEN=
# Portal → API Connect → Click to Call Support API → key whose destination is the Voice Streaming bot
SMARTFLOW_C2C_API_KEY=
# Optional caller ID (DID) shown to the customer, e.g. 918065255771. Defaults to the key's number.
SMARTFLOW_CALLER_ID=
# Seconds between outbound call requests (keep at or above 1 / account CPS). Default 2.
SMARTFLOW_CALL_GAP_SECONDS=2

# ── Dashboard sign-in ──────────────────────────────────────────
# The first admin account, created on startup when no accounts exist yet (ignored after that).
# The admin then creates other users from the Users page. Password: at least 8 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Session cookie "Secure" flag. Detected automatically from https / X-Forwarded-Proto; set to
# true or false to override (e.g. true behind a proxy that doesn't send X-Forwarded-Proto).
COOKIE_SECURE=

# ── Post-call summary email ────────────────────────────────────
# Sent to the email of the dashboard user who started the call. Off until one option is set.
# Option 1 — Outlook / Microsoft 365 (Microsoft Graph). Entra ID app registration with the
# Mail.Send application permission.
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# The Microsoft 365 mailbox / user principal name sending the email
OUTLOOK_SENDER_EMAIL=
# Option 2 — SMTP (used only when the Outlook settings above are empty), e.g. smtp.gmail.com
# with a Gmail app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
